# GEMINI_API_KEY: Required for Gemini AI API calls.
# The hosting platform injects this at runtime from environment secrets.
# Configure this via your environment variables/secrets manager.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
# The hosting platform injects this at runtime with the service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Secret keys for signing JSON Web Tokens and encrypting Safeguarding reports
JWT_SECRET=
SAFEGUARDING_SECRET=

# FIREBASE_SERVICE_ACCOUNT: A JSON service-account key string of your Firebase project.
# Required in production to connect to the real Firestore database.
# Paste the full contents of the JSON service account key file here as a single-line string.
FIREBASE_SERVICE_ACCOUNT=

# FORCE_MOCK_FIRESTORE: Set to "true" for local development to skip ANY attempt to
# contact real Firebase/Google Cloud entirely (no ADC lookup, no metadata-server probing).
# Recommended for local dev when you don't have a Firebase service account handy — avoids
# a known crash where Google Auth's background credential discovery can hard-exit the
# process instead of failing gracefully. Data is stored in a local file
# ('local-firestore.json') and survives restarts.
FORCE_MOCK_FIRESTORE=

# REQUIRE_REAL_FIRESTORE: Set to "true" to force real Firestore connection even in development.

# --- Safaricom Daraja (M-Pesa STK Push) ---
# Get these from https://developer.safaricom.co.ke after creating an app.
# Leave DARAJA_CONSUMER_KEY unset to keep M-Pesa payment collection disabled — the
# platform falls back to manual "mark as paid" everywhere it's used, it does not fake
# a successful payment.
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
# Paybill/Till shortcode used for STK Push (use 174379 for Safaricom's shared sandbox shortcode)
DARAJA_SHORTCODE=
# Lipa na M-Pesa Online Passkey, from the Daraja portal for your shortcode
DARAJA_PASSKEY=
# "sandbox" or "production" — controls which Daraja API host is used
DARAJA_ENV=sandbox
# Publicly reachable HTTPS URL Safaricom will POST payment results to. Must be reachable
# from the internet (ngrok/similar for local dev) — Safaricom cannot reach localhost.
DARAJA_CALLBACK_URL=
# If set to "true" (or in production), the server will crash on startup if connection fails.
REQUIRE_REAL_FIRESTORE=

# Environment label displayed in the sidebar telemetry panel. Defaults to PRODUCTION_CLOUD / LOCAL_DEVELOPMENT if unset.
VITE_APP_ENV=

# VERIFICATION_SECRET: signs QR/verification tokens so verification links can't be forged.
# Generate with: openssl rand -hex 32
VERIFICATION_SECRET=

# APP_SEED_MODE: controls initial database seeding on first-time boot.
# - "production" (Default): Seeds a minimal secure setup with one Chairperson admin ("chairperson@example.com")
#   with a randomized temporary PIN logged to console and forced password change. No demo data is seeded.
# - "demo": Seeds the full rich database with 15 mock/demo collections (partners, assets, budgets, classes, etc.) for testing.
APP_SEED_MODE=production

# Google reCAPTCHA v3 Secret Key. Get one free from: https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=

# Google reCAPTCHA v3 Site Key (public, safe for client-side).
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SITE_KEY=

# Node Environment: Set to "production" in real deployments.
NODE_ENV=

# Set to "true" to skip Google reCAPTCHA v3 verification during local development/testing.
# NEVER set to "true" in production.
SKIP_RECAPTCHA_FOR_LOCAL_DEV=



